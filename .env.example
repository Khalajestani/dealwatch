# Copy to .env for running on this Mac (make dev). Safe to copy as it is: every setting is optional, see
# src/dealwatch/config.py for the defaults. On the Pi, /srv/dealwatch/.env is written by deploy/dealwatch/make-env.sh.
# Comments go on their own line: one after an empty value becomes the value.

# --- Access -------------------------------------------------------------------------------------------------------
# The login page's password. Empty: no login, only for a machine nobody else can reach.
DEALWATCH_AUTH_PASSWORD=
# Signs the login cookie; required with a password. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEALWATCH_SECRET_KEY=

# --- Claude -------------------------------------------------------------------------------------------------------
# Your Claude plan token from `make assistant-token` (docs/assistant.md). Empty: price checks, the smart entry and
# Ask are off; everything else works.
DEALWATCH_CLAUDE_CODE_OAUTH_TOKEN=

# --- Data ---------------------------------------------------------------------------------------------------------
DEALWATCH_DATA_DIR=data
DEALWATCH_BACKUPS_DIR=backups
DEALWATCH_BACKUPS_KEEP=30
