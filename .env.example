# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for real runs.
ANTHROPIC_API_KEY=sk-ant-...

# Where the SQLite database and reports live (default: ./data)
# DEALWATCH_DATA_DIR=./data

# Web UI bind address (default 127.0.0.1:8765)
# DEALWATCH_HOST=127.0.0.1
# DEALWATCH_PORT=8765

# Set to 1 to use the built-in fake search client (no API credits spent). Handy for trying the UI.
# DEALWATCH_FAKE_LLM=0

# Set to 0 to disable the in-process scheduler when running `dealwatch serve`.
# DEALWATCH_SCHEDULER=1

# Optional e-mail notifications (select "email" in Settings > Notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=you@gmail.com
# SMTP_TO=you@gmail.com

# Optional Telegram notifications (select "telegram" in Settings > Notifications)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
